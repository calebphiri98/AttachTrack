.srOnly {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}

.error {
  margin: 0 0 16px; padding: 12px 16px; font-size: 0.92rem;
  color: var(--sv-danger); background: var(--sv-danger-bg);
  border: 1px solid #fecdca; border-radius: var(--sv-radius-sm);
}

.stats {
  display: grid; gap: 12px; margin: 0 0 20px; padding: 0; list-style: none;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
}
.stat {
  display: flex; flex-direction: column; gap: 2px; padding: 16px 18px;
  background: var(--sv-surface); border: 1px solid var(--sv-line);
  border-radius: var(--sv-radius-md); box-shadow: var(--sv-shadow);
}
.statValue {
  font-size: 1.75rem; font-weight: 700; line-height: 1.1;
  letter-spacing: -0.02em; color: var(--sv-ink);
}
.statLabel { font-size: 0.88rem; color: var(--sv-muted); text-transform: capitalize; }

.panel {
  background: var(--sv-surface); border: 1px solid var(--sv-line);
  border-radius: var(--sv-radius-lg); box-shadow: var(--sv-shadow); overflow: hidden;
}
.toolbar {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 14px 18px; border-bottom: 1px solid var(--sv-line);
}
.search {
  position: relative; display: flex; align-items: center;
  flex: 1 1 280px; max-width: 380px; color: var(--sv-muted);
}
.search svg { position: absolute; left: 12px; pointer-events: none; }
.searchInput {
  width: 100%; min-height: 40px; padding: 8px 12px 8px 38px; font: inherit;
  color: var(--sv-ink); background: var(--sv-canvas);
  border: 1px solid var(--sv-line); border-radius: var(--sv-radius-sm);
  transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}
.searchInput:focus {
  outline: none; background: var(--sv-surface);
  border-color: var(--sv-accent); box-shadow: var(--sv-focus);
}
.count { margin: 0; font-size: 0.85rem; color: var(--sv-muted); white-space: nowrap; }

.table { width: 100%; border-collapse: collapse; }
.table th {
  padding: 10px 18px; text-align: left; font-size: 0.82rem; font-weight: 600;
  color: var(--sv-muted); background: var(--sv-canvas);
  border-bottom: 1px solid var(--sv-line);
}
.table td { padding: 14px 18px; vertical-align: middle; border-bottom: 1px solid var(--sv-line); }
.row:last-child td { border-bottom: none; }
.row { transition: background 0.12s ease; }
.row:hover { background: var(--sv-hover); }
.actionCol { width: 1%; text-align: right !important; white-space: nowrap; }

.person { display: flex; align-items: center; gap: 12px; min-width: 0; }
.personText { display: flex; flex-direction: column; min-width: 0; }
.name {
  font-weight: 600; color: var(--sv-ink); text-decoration: none; overflow-wrap: anywhere;
}
.name:hover { color: var(--sv-accent); }
.name:focus-visible, .viewBtn:focus-visible { outline: none; box-shadow: var(--sv-focus); border-radius: 6px; }
.email { font-size: 0.85rem; color: var(--sv-muted); overflow-wrap: anywhere; }

.viewBtn {
  display: inline-flex; align-items: center; min-height: 36px; padding: 6px 14px;
  font-size: 0.88rem; font-weight: 600; color: var(--sv-accent); text-decoration: none;
  background: var(--sv-surface); border: 1px solid var(--sv-line);
  border-radius: var(--sv-radius-sm);
  transition: border-color 0.15s ease, background 0.15s ease;
}
.viewBtn:hover { border-color: var(--sv-accent); background: color-mix(in srgb, var(--sv-accent) 6%, white); }

.noResults { margin: 0; padding: 32px 18px; text-align: center; color: var(--sv-muted); }

.empty {
  padding: 48px 24px; text-align: center; background: var(--sv-surface);
  border: 1px dashed var(--sv-line); border-radius: var(--sv-radius-lg);
}
.emptyTitle { margin: 0 0 6px; font-size: 1.1rem; color: var(--sv-ink); }
.emptyText { margin: 0 auto; max-width: 46ch; color: var(--sv-muted); }

.skeletonWrap {
  display: flex; flex-direction: column; gap: 1px; overflow: hidden;
  background: var(--sv-line); border: 1px solid var(--sv-line); border-radius: var(--sv-radius-lg);
}
.skeletonRow { display: flex; align-items: center; gap: 12px; padding: 16px 18px; background: var(--sv-surface); }
.skeletonDot, .skeletonBar {
  background: linear-gradient(90deg, #eef1f6 25%, #f7f9fc 50%, #eef1f6 75%);
  background-size: 200% 100%; animation: shimmer 1.4s linear infinite;
}
.skeletonDot { width: 40px; height: 40px; border-radius: 50%; }
.skeletonBar { height: 14px; width: 40%; border-radius: 6px; }
@keyframes shimmer { to { background-position: -200% 0; } }

@media (max-width: 640px) {
  .toolbar { flex-direction: column; align-items: stretch; }
  .search { max-width: none; }
  .table thead { display: none; }
  .table, .table tbody, .table tr, .table td { display: block; width: 100%; }
  .row { padding: 14px 18px; border-bottom: 1px solid var(--sv-line); }
  .row:last-child { border-bottom: none; }
  .table td { padding: 4px 0; border: none; }
  .actionCol { width: 100%; text-align: left !important; padding-top: 10px !important; }
}

@media (prefers-reduced-motion: reduce) {
  .skeletonDot, .skeletonBar { animation: none; }
  .row, .viewBtn, .searchInput { transition: none; }
}
